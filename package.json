{
  "name": "gladys-zwavejs",
  "version": "1.1.0",
  "private": true,
  "description": "Z-Wave JS UI integration for Gladys Assistant, running as an external integration.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "node index.ts",
    "typecheck": "tsc --noEmit",
